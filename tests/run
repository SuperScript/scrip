#!/bin/sh

home="$(pwd)"
_sort="env LC_ALL=POSIX sort"
_make="${MAKE:-make}"

PATH="${home}/bin:$PATH"
export PATH

scrip=scrip
basedir="${home}/tests/basedir"
bindir="${home}/bin"
libdir="${home}/share/scrip"

####

# _silence prog
_silence() {
  "$@" >/dev/null 2>&1
}

# _sanitize < input > output
_sanitize() {
  sed \
    -e "s!${home}!...!"g
}

# _check prog
_check() {
  { "$@" 2>&1 ; echo $?; } | _sanitize
}

# _check_err prog
_check_err() {
  { "$@" 2>&1 >/dev/null ; echo $?; } | grep -E 'fatal:|(^[0-9]+)' | _sanitize
}

# _check_sort prog
_check_sort() {
  _check "$@" | ${_sort}
}

# _run headline
_run() {
  printf '\n\n==== %s ====\n\n' "$1"
}

# _check_prog progname interpreter < program
_check_prog() {
  local prog="$1"
  shift
  cat - > "${basedir}/${prog}.tmp"
  env SCRIP_PATH="${libdir}" ${scrip} code "${basedir}/${prog}.tmp" > "${basedir}/${prog}"
  rm -f "${basedir}/${prog}.tmp"
  _check "$@" "${basedir}/${prog}"
}

# _modes dir
#   Print the mode and path of every file under dir, sorted
_modes() {
  ( cd "$1" && find . -type f | ${_sort} | while read -r f
    do
      printf '%s %s\n' "$(ls -l "${f}" | cut -d' ' -f1)" "${f}"
    done )
}

# _make_install pkg prefix
#   Install the package to prefix and list what landed, with modes
_make_install() {
  local pkg="$1"
  local prefix="$2"
  ( cd "${pkg}" && ${_make} install PREFIX="${prefix}" ) || return
  _modes "${prefix}"
}

# _make_uninstall pkg prefix
#   Uninstall the package from prefix and list the files and
#   directories that survive
_make_uninstall() {
  local pkg="$1"
  local prefix="$2"
  ( cd "${pkg}" && ${_make} uninstall PREFIX="${prefix}" ) || return
  ( cd "${prefix}" && find . -type f | ${_sort} )
  ( cd "${prefix}" && find . -type d | ${_sort} )
}

####

cd tests
rm -rf "${basedir}"

mkdir -p "${basedir}"
cp -r ../src "${basedir}"
cd "${basedir}"

_run 'bin/scrip prints usage'
_check ${scrip}

_run 'bin/scrip help offers help'
_check ${scrip} help

_run 'bin/scrip deps lists dependencies'
cat - > "${basedir}/scriptest" <<'EOF'
#!/bin/sh
#include "safe.sh"
safe nosuchprogram
EOF

_check env SCRIP_PATH="${libdir}" ${scrip} deps "${basedir}/scriptest"

_run 'bin/scrip code resolves includes'
_check env SCRIP_PATH="${libdir}" ${scrip} code "${basedir}/scriptest"

_run 'bin/scrip deps reads stdin when no files given'
_check env SCRIP_PATH="${libdir}" ${scrip} deps < "${basedir}/scriptest"

_run 'bin/scrip code reads stdin when no files given'
_check env SCRIP_PATH="${libdir}" ${scrip} code < "${basedir}/scriptest"

_run 'bin/scrip borrow copies dependencies to current directory'
mkdir -p "${basedir}/borrow"
_check env SCRIP_PATH="${libdir}" ${scrip} borrow "${basedir}/borrow" safe.sh barf.sh shout.sh

_run 'ditto prints single argument to stdout'
_check_prog ditto_single sh <<'EOF'
#!/bin/sh
#include "ditto.sh"
ditto "test message"
EOF

_run 'ditto prints multiple arguments to stdout'
_check_prog ditto_multi sh <<'EOF'
#!/bin/sh
#include "ditto.sh"
ditto "first" "second" "third"
EOF

_run 'ditt prints single argument to stdout without newline'
_check_prog ditt_single sh <<'EOF'
#!/bin/sh
#include "ditt.sh"
ditt "test message"
EOF

_run 'ditt prints multiple arguments to stdout without newline'
_check_prog ditt_multi sh <<'EOF'
#!/bin/sh
#include "ditt.sh"
ditt "first" "second" "third"
EOF

_run 'shout prints message to stderr'
_check_prog shout_test sh <<'EOF'
#!/bin/sh
#include "shout.sh"
shout "test message"
EOF

_run 'shout.awk prints message to stderr'
_check_prog shout_awk_test.awk awk -f <<'EOF'
#include "shout.awk"
BEGIN { shout("test message"); }
EOF

_run 'barf prints fatal message and exits with 111'
_check_prog barf_test sh <<'EOF'
#!/bin/sh
#include "barf.sh"
barf "test error"
EOF

_run 'barf.awk prints fatal message and exits with 111'
_check_prog barf_awk_test.awk awk -f <<'EOF'
#include "barf.awk"
BEGIN { barf("test error"); }
EOF

_run 'safe succeeds with valid command'
_check_prog safe_success sh <<'EOF'
#!/bin/sh
#include "safe.sh"
safe echo "hello world"
EOF

_run 'safe fails and shows error'
_check_prog safe_fail sh <<'EOF'
#!/bin/sh
#include "safe.sh"
safe false
EOF

_run 'usage prints usage message and exits with 100'
_check_prog usage_test sh <<'EOF'
#!/bin/sh
#include "usage.sh"
usage "this is output from usage to standard error"
EOF

_run 'atomic_to writes output atomically on success'
_check_prog atomic_to_test sh <<'EOF'
#!/bin/sh
#include "atomic_to.sh"
atomic_to "output.txt" echo "test content"
cat "output.txt"
EOF

_run 'atomic_to cleans up on failure'
_check_prog atomic_to_fail sh <<'EOF'
#!/bin/sh
#include "atomic_to.sh"
(atomic_to "fail_output.txt" false)
if [ -f "fail_output.txt" ]; then
  echo "ERROR: fail_output.txt should not exist"
else
  echo "OK: fail_output.txt does not exist"
fi
EOF

_run 'atomic_to_mode writes output with correct mode'
_check_prog atomic_to_mode_test sh <<'EOF'
#!/bin/sh
#include "atomic_to_mode.sh"
atomic_to_mode "script.sh" "755" echo "#!/bin/sh"
ls -l "script.sh" | cut -d' ' -f1
cat "script.sh"
EOF

_run 'atomic_to_mode cleans up on failure'
_check_prog atomic_to_mode_fail sh <<'EOF'
#!/bin/sh
#include "atomic_to_mode.sh"
(atomic_to_mode "fail_script.sh" "755" false)
if [ -f "fail_script.sh" ]; then
  echo "ERROR: fail_script.sh should not exist"
else
  echo "OK: fail_script.sh does not exist"
fi
EOF

_run 'pipewith with do_ works'
_check_prog pipewith_do sh <<'EOF'
#!/bin/sh
#include "pipewith.sh"
#include "do_.sh"
do_echo() { printf '%s\n' "$*"; }
do_sed() { sed "$@"; }
pipewith do_ :: echo "hereur" :: sed 's/^/thereugo\n/'
EOF

_run 'pipewith with do_run works'
_check_prog pipewith_do_run sh <<'EOF'
#!/bin/sh
#include "pipewith.sh"
#include "do_.sh"
#include "do_run.sh"
do_echo() { printf '%s\n' "$*"; }
do_tr() { tr "$@"; }
pipewith do_ :: echo "hereur" :: run sed 's/^/thereugo\n/' :: tr '[a-z]' '[A-Z]'
EOF

_run 'pipewith with do_xrun works'
_check_prog pipewith_do_xrun sh <<'EOF'
#!/bin/sh
#include "pipewith.sh"
#include "do_.sh"
#include "do_xrun.sh"
do_echos() { printf '%s\n' "$@"; }
do_tr() { tr "$@"; }
pipewith do_ :: echos "hereur" "thereugo" :: xrun -L1 sh -c 'printf "%s\n" "$*"' xrun "X:" :: tr '[a-z]' '[A-Z]'
EOF

_run 'pipewith with single command (with separator)'
_check_prog pipewith_single sh <<'EOF'
#!/bin/sh
#include "pipewith.sh"
doit() {
  "$@"
}
pipewith doit '|' echo "no pipe here"
EOF

_run 'pipewith with single command (without separator)'
_check_prog pipewith_single sh <<'EOF'
#!/bin/sh
#include "pipewith.sh"
doit() {
  "$@"
}
pipewith doit '' echo "no pipe here"
EOF

_run 'pipewith pipes two commands'
_check_prog pipewith_simple sh <<'EOF'
#!/bin/sh
#include "pipewith.sh"
doit() {
  "$@"
}
pipewith doit '|' echo 'hello world' '|' sed 's/^h/H/'
EOF

_run 'pipewith chains multiple commands'
_check_prog pipewith_multi sh <<'EOF'
#!/bin/sh
#include "pipewith.sh"
doit() {
  "$@"
}
pipewith doit :: printf '%s\n' line3 line2 line1 :: sort :: head -n 1
EOF

_run 'pipeline with single command (with separator)'
_check_prog pipeline_single sh <<'EOF'
#!/bin/sh
#include "pipeline.sh"
pipeline '|' echo "no pipe here"
EOF

_run 'pipeline with single command (without separator)'
_check_prog pipeline_single sh <<'EOF'
#!/bin/sh
#include "pipeline.sh"
pipeline '' echo "no pipe here"
EOF

_run 'pipeline pipes two commands'
_check_prog pipeline_simple sh <<'EOF'
#!/bin/sh
#include "pipeline.sh"
pipeline '|' echo 'hello world' '|' sed 's/^h/H/'
EOF

_run 'pipeline chains multiple commands'
_check_prog pipeline_multi sh <<'EOF'
#!/bin/sh
#include "pipeline.sh"
pipeline :: printf '%s\n' line3 line2 line1 :: sort :: head -n 1
EOF

_run 'have_args returns 0 when enough arguments provided'
_check_prog have_args_success sh <<'EOF'
#!/bin/sh
#include "have_args.sh"
if have_args 2 arg1 arg2 arg3; then
  echo "SUCCESS: have_args returned 0"
else
  echo "FAIL: have_args returned non-zero"
fi
EOF

_run 'have_args returns 1 when not enough arguments provided'
_check_prog have_args_fail sh <<'EOF'
#!/bin/sh
#include "have_args.sh"
if have_args 3 arg1 arg2; then
  echo "FAIL: have_args returned 0"
else
  echo "SUCCESS: have_args returned 1"
fi
EOF

_run 'have_args with no arguments shows usage and exits'
_check_prog have_args_no_args sh <<'EOF'
#!/bin/sh
#include "have_args.sh"
have_args
EOF

_run 'bin/pipeline prints usage and exits'
_check "${bindir}/pipeline"

_run 'bin/pipeline requires a program'
_check "${bindir}/pipeline" ::

_run 'bin/pipeline runs a program'
_check "${bindir}/pipeline" :: echo hereur

_run 'bin/pipeline pipelines programs'
_check "${bindir}/pipeline" :: echo hereur :: sh -c 'echo thereugo && cat -'


_run 'bin/scrip docs takes file arguments'
_check "${bindir}/scrip" docs "${bindir}/pipeline" "${bindir}/scrip"

_run 'bin/scrip make emits Makefile rule'
_check env SCRIP_PATH="${libdir}" "${bindir}/scrip" make pipeline

_run 'do_to writes output atomically on success'
_check_prog do_to_test sh <<'EOF'
#!/bin/sh
#include "do_to.sh"
#include "do_run.sh"
do_to "output.txt" run echo "test content"
cat "output.txt"
EOF

_run 'do_to cleans up on failure'
_check_prog do_to_fail sh <<'EOF'
#!/bin/sh
#include "do_to.sh"
#include "do_run.sh"
(do_to "fail_output.txt" run false)
if [ -f "fail_output.txt" ]; then
  echo "ERROR: fail_output.txt should not exist"
else
  echo "OK: fail_output.txt does not exist"
fi
EOF

_run 'do_to calls do_ prefixed function'
_check_prog do_to_prefix sh <<'EOF'
#!/bin/sh
#include "do_to.sh"
do_echo() {
  echo "do_echo was called with: $*"
}
do_to "prefix_test.txt" echo "hello world"
cat "prefix_test.txt"
EOF

_run 'do_to with multi-argument command'
_check_prog do_to_multiarg sh <<'EOF'
#!/bin/sh
#include "do_to.sh"
#include "do_run.sh"
do_to "multi.txt" run printf '%s\n' "line1" "line2" "line3"
cat "multi.txt"
EOF

_run 'do_to creates directories'
_check_prog do_to_prefix sh <<'EOF'
#!/bin/sh
#include "do_to.sh"
do_echo() {
  echo "do_echo was called with: $*"
}
do_to "do-to-test/foo/bar/directory_test.txt" echo "hello world"
cat "prefix_test.txt"
EOF

_run 'do_set with no options dispatches tail'
_check_prog do_set_noopt sh <<'EOF'
#!/bin/sh
#include "do_.sh"
#include "do_set.sh"
#include "do_run.sh"
do_set run echo "hello from do_set"
EOF

_run 'do_set applies single option'
_check_prog do_set_single sh <<'EOF'
#!/bin/sh
#include "do_.sh"
#include "do_set.sh"
do_show_x() {
  case "$-" in
    *x*) echo "trace: on" ;;
    *)   echo "trace: off" ;;
  esac
}
do_set +x show_x 2>/dev/null
do_set -x show_x 2>/dev/null
EOF

_run 'do_set turns off option with +'
_check_prog do_set_off sh <<'EOF'
#!/bin/sh
#include "do_.sh"
#include "do_set.sh"
do_show_x() {
  case "$-" in
    *x*) echo "trace: on" ;;
    *)   echo "trace: off" ;;
  esac
}
exec 2>/dev/null
set -x
do_set +x show_x
EOF

_run 'do_set applies multiple options'
_check_prog do_set_multi sh <<'EOF'
#!/bin/sh
#include "do_.sh"
#include "do_set.sh"
do_show_xu() {
  case "$-" in
    *u*) echo "nounset: on" ;;
    *)   echo "nounset: off" ;;
  esac
  case "$-" in
    *x*) echo "trace: on" ;;
    *)   echo "trace: off" ;;
  esac
}
do_set -u -x show_xu 2>/dev/null
EOF

_run 'do_set -o handles two-argument option'
_check_prog do_set_opt_o sh <<'EOF'
#!/bin/sh
#include "do_.sh"
#include "do_set.sh"
do_show_x() {
  case "$-" in
    *x*) echo "trace: on" ;;
    *)   echo "trace: off" ;;
  esac
}
do_set -o xtrace show_x 2>/dev/null
EOF

_run 'do_set chains with do_env'
_check_prog do_set_compose sh <<'EOF'
#!/bin/sh
#include "do_.sh"
#include "do_set.sh"
#include "do_env.sh"
do_show() {
  echo "VAR=${VAR}"
  case "$-" in
    *x*) echo "trace: on" ;;
    *)   echo "trace: off" ;;
  esac
}
do_set -x env VAR=hello show 2>/dev/null
EOF

_run 'do_set via do_ dispatch'
_check_prog do_set_dispatch sh <<'EOF'
#!/bin/sh
#include "do_.sh"
#include "do_set.sh"
do_show_x() {
  case "$-" in
    *x*) echo "trace: on" ;;
    *)   echo "trace: off" ;;
  esac
}
do_ set -x show_x 2>/dev/null
EOF

_run 'do_env with no vars dispatches tail'
_check_prog do_env_novar sh <<'EOF'
#!/bin/sh
#include "do_.sh"
#include "do_env.sh"
#include "do_run.sh"
do_env run echo "hello from do_env"
EOF

_run 'do_env exports single variable'
_check_prog do_env_single sh <<'EOF'
#!/bin/sh
#include "do_.sh"
#include "do_env.sh"
do_show_var() {
  echo "VAR=${VAR}"
}
do_env VAR=hello show_var
EOF

_run 'do_env exports multiple variables'
_check_prog do_env_multi sh <<'EOF'
#!/bin/sh
#include "do_.sh"
#include "do_env.sh"
do_show_vars() {
  echo "A=${A} B=${B}"
}
do_env A=1 B=2 show_vars
EOF

_run 'do_env chains with do_set'
_check_prog do_env_chain sh <<'EOF'
#!/bin/sh
#include "do_.sh"
#include "do_env.sh"
#include "do_set.sh"
do_show_var_x() {
  echo "VAR=${VAR}"
  case "$-" in
    *x*) echo "trace: on" ;;
    *)   echo "trace: off" ;;
  esac
}
do_env VAR=hello set -x show_var_x 2>/dev/null
EOF

_run 'do_env via do_ dispatch'
_check_prog do_env_dispatch sh <<'EOF'
#!/bin/sh
#include "do_.sh"
#include "do_env.sh"
do_show_var() {
  echo "VAR=${VAR}"
}
do_ env VAR=hello show_var
EOF

_run 'bin/scrip prog requires arguments'
_check ${scrip} prog

_run 'bin/scrip prog requires at least two arguments'
_check ${scrip} prog script.sh

_run 'bin/scrip prog creates executable script'
cat - > "${basedir}/prog_test.sh" <<'EOF'
#!/bin/sh
#include "shout.sh"
shout "hello from prog test"
EOF
_check env SCRIP_PATH="${libdir}" ${scrip} prog "${basedir}/prog_output" "${basedir}/prog_test.sh"

_run 'bin/scrip prog output resolves includes'
_check head -n 5 "${basedir}/prog_output"

_run 'bin/scrip prog output is executable'
_check "${basedir}/prog_output"

_run 'bin/scrip prog with multiple source files'
cat - > "${basedir}/prog_multi1.sh" <<'EOF'
#!/bin/sh
#include "shout.sh"
shout "prog_multi1.sh"
EOF
cat - > "${basedir}/prog_multi2.sh" <<'EOF'
#include "shout.sh"
shout "prog_multi2.sh"
EOF
_check env SCRIP_PATH="${libdir}" ${scrip} prog "${basedir}/prog_multi_output" "${basedir}/prog_multi1.sh" "${basedir}/prog_multi2.sh"
_check "${basedir}/prog_multi_output"

_run 'bin/scrip path prints SCRIP_PATH when set'
_check env SCRIP_PATH="/custom/path" ${scrip} path

_run 'bin/scrip path prints default path when SCRIP_PATH unset'
_check env -u SCRIP_PATH ${scrip} path

mkdir -p "${basedir}/listlib1"
touch "${basedir}/listlib1/alpha.sh" "${basedir}/listlib1/beta.sh" "${basedir}/listlib1/gamma.awk"
mkdir -p "${basedir}/listlib2"
touch "${basedir}/listlib2/delta.sh"

_run 'bin/scrip list shows files in SCRIP_PATH'
_check_sort env SCRIP_PATH="${basedir}/listlib1" ${scrip} list

_run 'bin/scrip list filters by regex'
_check_sort env SCRIP_PATH="${basedir}/listlib1" ${scrip} list '\.awk$'

_run 'bin/scrip list with no matches prints nothing'
_check env SCRIP_PATH="${basedir}/listlib1" ${scrip} list 'zzz_no_match'

_run 'bin/scrip list searches multiple SCRIP_PATH directories'
_check_sort env SCRIP_PATH="${basedir}/listlib1:${basedir}/listlib2" ${scrip} list

_run 'do_while executes command for each line'
_check_prog do_while_basic sh <<'EOF'
#!/bin/sh
#include "do_while.sh"
do_greet() { echo "hello $1"; }
printf 'alice\nbob\ncharlie\n' | do_while greet
EOF

_run 'do_while with empty stdin produces no output'
_check_prog do_while_empty sh <<'EOF'
#!/bin/sh
#include "do_while.sh"
do_greet() { echo "hello $1"; }
printf '' | do_while greet
echo "done"
EOF

_run 'do_while passes entire line as argument'
_check_prog do_while_line sh <<'EOF'
#!/bin/sh
#include "do_while.sh"
do_show() { echo "got: $1"; }
printf 'one two three\nfour five\n' | do_while show
EOF

_run 'do_while chains with do_run'
_check_prog do_while_chain sh <<'EOF'
#!/bin/sh
#include "do_while.sh"
#include "do_run.sh"
printf 'hello\nworld\n' | do_while run echo
EOF

_run 'do_foreach executes command for each line'
_check_prog do_foreach_basic sh <<'EOF'
#!/bin/sh
#include "do_foreach.sh"
do_greet() { echo "hello $1"; }
printf 'alice\nbob\ncharlie\n' | do_foreach greet
EOF

_run 'do_foreach with empty stdin produces no output'
_check_prog do_foreach_empty sh <<'EOF'
#!/bin/sh
#include "do_foreach.sh"
do_greet() { echo "hello $1"; }
printf '' | do_foreach greet
echo "done"
EOF

_run 'do_foreach passes entire line as first argument'
_check_prog do_foreach_line sh <<'EOF'
#!/bin/sh
#include "do_foreach.sh"
do_show() { echo "got: $1"; }
printf 'one two three\nfour five\n' | do_foreach show
EOF

_run 'do_foreach passes trailing arguments after the line'
_check_prog do_foreach_args sh <<'EOF'
#!/bin/sh
#include "do_foreach.sh"
do_show() { echo "$1 -> $2 $3"; }
printf 'alice\nbob\n' | do_foreach show x y
EOF

_run 'do_foreach chains with do_env'
_check_prog do_foreach_chain sh <<'EOF'
#!/bin/sh
#include "do_foreach.sh"
#include "do_env.sh"
#include "do_run.sh"
printf 'X=1\nX=2\n' | do_foreach env run sh -c 'echo "$X"'
EOF

_run 'do_pipeline pipes two commands'
_check_prog do_pipeline_simple sh <<'EOF'
#!/bin/sh
#include "do_pipeline.sh"
do_pipeline '|' echo 'hello world' '|' sed 's/^h/H/'
EOF

_run 'do_pipeline chains multiple commands'
_check_prog do_pipeline_multi sh <<'EOF'
