EOF

_run 'pipe pipes two do_ functions'
_check_prog pipe_simple sh <<'EOF'
#!/bin/sh
#include "pipe.sh"
do_echo() { printf '%s\n' "$*"; }
do_sed() { sed "$@"; }
pipe :: echo "hello world" :: sed 's/^h/H/'
EOF

_run 'pipe chains multiple do_ functions'
_check_prog pipe_multi sh <<'EOF'
#!/bin/sh
#include "pipe.sh"
do_lines() { printf '%s\n' "$@"; }
do_sort() { sort; }
do_head() { head "$@"; }
pipe :: lines line3 line2 line1 :: sort :: head -n 1
EOF

_run 'do_pipe pipes two do_ functions'
_check_prog do_pipe_simple sh <<'EOF'
#!/bin/sh
#include "do_pipe.sh"
do_echo() { printf '%s\n' "$*"; }
do_sed() { sed "$@"; }
do_pipe :: echo "hello world" :: sed 's/^h/H/'
EOF

_run 'do_pipe chains multiple do_ functions'
_check_prog do_pipe_multi sh <<'EOF'
#!/bin/sh
#include "do_pipe.sh"
do_lines() { printf '%s\n' "$@"; }
do_sort() { sort; }
do_head() { head "$@"; }
do_pipe :: lines line3 line2 line1 :: sort :: head -n 1
EOF

_run 'do_pipe via do_ dispatch'
_check_prog do_pipe_dispatch sh <<'EOF'
#!/bin/sh
#include "do_.sh"
#include "do_pipe.sh"
do_echo() { printf '%s\n' "$*"; }
do_ pipe :: echo "dispatched"
EOF

_run 'do_to_mode writes output with correct mode'
_check_prog do_to_mode_test sh <<'EOF'
#!/bin/sh
#include "do_to_mode.sh"
#include "do_run.sh"
do_to_mode "script.sh" "755" run echo "#!/bin/sh"
ls -l "script.sh" | cut -d' ' -f1
cat "script.sh"
EOF

_run 'do_to_mode cleans up on failure'
_check_prog do_to_mode_fail sh <<'EOF'
#!/bin/sh
#include "do_to_mode.sh"
#include "do_run.sh"
(do_to_mode "fail_script.sh" "755" run false)
if [ -f "fail_script.sh" ]; then
  echo "ERROR: fail_script.sh should not exist"
else
  echo "OK: fail_script.sh does not exist"
fi
EOF

_run 'do_to_mode calls do_ prefixed function'
_check_prog do_to_mode_prefix sh <<'EOF'
#!/bin/sh
#include "do_to_mode.sh"
do_echo() {
  echo "do_echo was called with: $*"
}
do_to_mode "prefix_mode.txt" "644" echo "hello world"
cat "prefix_mode.txt"
EOF

_run 'do_to_mode creates directories'
_check_prog do_to_mode_mkdir sh <<'EOF'
#!/bin/sh
#include "do_to_mode.sh"
#include "do_run.sh"
do_to_mode "do-to-mode-test/sub/dir/out.sh" "755" run echo "#!/bin/sh"
ls -l "do-to-mode-test/sub/dir/out.sh" | cut -d' ' -f1
cat "do-to-mode-test/sub/dir/out.sh"
EOF

_run 'atomic_to creates directories'
_check_prog atomic_to_mkdir sh <<'EOF'
#!/bin/sh
#include "atomic_to.sh"
atomic_to "atomic-to-test/sub/dir/output.txt" echo "test content"
cat "atomic-to-test/sub/dir/output.txt"
EOF

_run 'atomic_to_mode creates directories'
_check_prog atomic_to_mode_mkdir sh <<'EOF'
#!/bin/sh
#include "atomic_to_mode.sh"
atomic_to_mode "atomic-to-mode-test/sub/dir/script.sh" "755" echo "#!/bin/sh"
ls -l "atomic-to-mode-test/sub/dir/script.sh" | cut -d' ' -f1
cat "atomic-to-mode-test/sub/dir/script.sh"
EOF

fakepkg="${basedir}/fakepkg"
fakeprefix="${basedir}/fakeprefix"

mkdir -p "${fakepkg}/bin" "${fakepkg}/share/fake/sub"
cp "${libdir}/install.mk" "${fakepkg}/Makefile"
echo 'one' > "${fakepkg}/bin/one"
echo 'two' > "${fakepkg}/bin/two"
echo 'lib' > "${fakepkg}/share/fake/lib.sh"
echo 'deep' > "${fakepkg}/share/fake/sub/deep.sh"

_run 'install.mk installs a package tree under PREFIX'
_check _make_install "${fakepkg}" "${fakeprefix}"

_run 'install.mk uninstall removes installed files only'
echo 'stranger' > "${fakeprefix}/bin/stranger"
echo 'stranger' > "${fakeprefix}/share/fake/stranger"
_check _make_uninstall "${fakepkg}" "${fakeprefix}"

exit 0

